/dts-v1/;
#include <nordic/nrf5340_cpuapp_qkaa.dtsi>
#include <nordic/nrf5340_sram_partition.dtsi>
#include <nordic/nrf5340_shared_sram_partition.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
    model = "NORA-B106 Minimal P1";
    compatible = "nora,nora-b106-minimal";
    chosen {
        zephyr,sram = &sram0_image;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
        zephyr,cdc-acm-uart = &cdc_acm_uart0;
        zephyr,boot-mode = &boot_mode0;
    };
    zephyr,user {
        /* J3 pins 3..14, in order. No GPIO is assigned to the network core. */
        gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>, <&gpio1 6 GPIO_ACTIVE_HIGH>,
                <&gpio0 17 GPIO_ACTIVE_HIGH>, <&gpio0 18 GPIO_ACTIVE_HIGH>,
                <&gpio0 15 GPIO_ACTIVE_HIGH>, <&gpio0 10 GPIO_ACTIVE_HIGH>,
                <&gpio0 8 GPIO_ACTIVE_HIGH>, <&gpio0 12 GPIO_ACTIVE_HIGH>,
                <&gpio1 3 GPIO_ACTIVE_HIGH>, <&gpio1 0 GPIO_ACTIVE_HIGH>,
                <&gpio0 20 GPIO_ACTIVE_HIGH>, <&gpio0 7 GPIO_ACTIVE_HIGH>;
        io-channels = <&adc 3>;
    };
};

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpiote { status = "okay"; };

/* The module has its own 32 MHz crystal. u-blox specifies 20 pF load.
 * Zephyr programs the runtime register using factory FICR trim; no UICR edit. */
&hfxo {
    load-capacitors = "internal";
    load-capacitance-femtofarad = <20000>;
};
/* No external 32.768 kHz crystal: the board defconfig selects calibrated RC. */
&lfxo { status = "disabled"; };

&gpregret1 {
    status = "okay";
    boot_mode0: boot-mode@0 {
        compatible = "zephyr,retention";
        status = "okay";
        reg = <0 1>;
    };
};

zephyr_udc0: &usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
    cdc_acm_uart0: cdc-acm-uart0 { compatible = "zephyr,cdc-acm-uart"; };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN3>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <4>;
    };
};

/* Only application-core internal flash; network flash/UICR are untouched. */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        boot_partition: partition@0 { label = "mcuboot"; reg = <0x0 0x30000>; };
        slot0_partition: partition@30000 { label = "image-0"; reg = <0x30000 0x60000>; };
        slot1_partition: partition@90000 { label = "image-1"; reg = <0x90000 0x60000>; };
        storage_partition: partition@f0000 { label = "storage"; reg = <0xf0000 0x10000>; };
    };
};

/* The network core and its DFU shared-memory path are unused. */
/delete-node/ &sram0_dfu_shared;
&ipc0 { status = "disabled"; };
