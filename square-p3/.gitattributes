# Preserve generated flash images byte-for-byte so their SHA-256 hashes stay valid.
firmware/dist/*.hex binary
# KiCad's SVG exporter deliberately emits trailing spaces.
preview/*.svg whitespace=-blank-at-eol,-blank-at-eof
hardware/BOM.csv -text whitespace=cr-at-eol
# Retain upstream licence notices verbatim.
hardware/LICENSE-* -whitespace
firmware/licenses/** -whitespace
firmware/host-tools/licenses/** -whitespace
